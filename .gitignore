# --- Sidecars ---------------------------------------------------------------
# yt-dlp se baja en cada empaquetado, no se versiona (YouTube le rompe los
# extractores cada pocas semanas). En Linux no lleva extension, asi que el
# *.exe de mas abajo no lo cubre.
tool/ytdlp-build/
*.exe

# --- Salidas ----------------------------------------------------------------
dist/

# --- Entorno ----------------------------------------------------------------
.vscode/
.idea/
.claude/
*.log

# --- Nada de credenciales ---------------------------------------------------
# Las cookies de la sesion de YouTube viven en el directorio de datos del
# usuario, nunca en el arbol.
*.cookies
config.json
